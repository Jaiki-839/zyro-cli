# =========================================
# Jaiki CLI — Environment Configuration Template
# Copy this file to ".env" and fill in your keys,
# or configure them directly via CLI:
#   jaiki config set gemini-key <YOUR_KEY>
#   jaiki config set openai-key <YOUR_KEY>
# =========================================

# Google Gemini API key — used when provider=gemini (Default)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key — used by the "ai"/"chat"/"ask" commands when provider=openai
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Default AI provider: "gemini" | "openai"
JAIKI_DEFAULT_PROVIDER=gemini
